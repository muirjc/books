# Settings for books-backup.sh and books-restore.sh. Install as /etc/books/backup.env
# (root, mode 600). To run the restore script by hand, load it first:
#   sudo sh -c 'set -a; . /etc/books/backup.env; set +a; /opt/books/repo/deploy/pi/backup/books-restore.sh check'

# The Compose stack (compose.yaml and its .env).
COMPOSE_DIR=/opt/books/repo/deploy/pi

# The NAS share's folder for this app. It must contain the marker file
# .books-backup-target, which proves the share is mounted.
NAS_DIR=/mnt/nas/books

# The encrypted restic repository, on the NAS.
RESTIC_REPOSITORY=/mnt/nas/books/restic
# Root-only file holding the restic password. Keep a copy in the family password
# manager too: without it the encrypted backups can't be restored.
RESTIC_PASSWORD_FILE=/etc/books/restic-password

# Working space on the Pi; emptied after each run.
STAGING_DIR=/var/lib/books-backup

# Days of plain dumps on the NAS, and of daily restic snapshots.
KEEP_DAYS=30
