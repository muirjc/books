# Copy to .env next to compose.yaml, fill in, then: chmod 600 .env
# Never commit .env (spec section 10.4).

# The Pi's reserved LAN address; the proxy publishes 80/443 on it only.
PI_LAN_IP=

# Hex only, because it goes inside the database URL:  openssl rand -hex 32
POSTGRES_PASSWORD=

# At least 32 characters:  openssl rand -hex 32
BOOK_TRACKER_SECRET_KEY=

# First Admin, created at start-up only if none exists. Remove the password from this
# file after the first start.
BOOK_TRACKER_ADMIN_LOGIN=
BOOK_TRACKER_ADMIN_DISPLAY_NAME=
BOOK_TRACKER_ADMIN_PASSWORD=

# Optional: pin an image (e.g. sha-0cb28b0) instead of latest.
# BOOKS_TAG=latest
# Optional: where PostgreSQL's data lives on the host.
# BOOKS_DATA_DIR=/srv/books

# From spec 002 (author import) the app makes outbound HTTPS requests to openlibrary.org.
# No setting is needed: requests carry only the app name and version.

# From spec 012 (AI summary drafts) the app calls the Anthropic API (api.anthropic.com).
# Leave the key empty to turn drafting off: members then see "AI drafts aren't set up".
# Create the key in the Anthropic Console; it is a secret like the others in this file.
BOOK_TRACKER_ANTHROPIC_API_KEY=
# Optional: the model (default claude-opus-5-5) and drafts per member per day (default 10).
# BOOK_TRACKER_AI_MODEL=claude-opus-5-5
# BOOK_TRACKER_AI_DAILY_DRAFT_LIMIT=10
